# PnL is — (new signals, no current price data in snapshot)

NEW_TICKER_CONTENT = """
      <div class="pk pos">
        <div class="pk-row1"><span class="pk-sym svb-tk-name">ASTS</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$96.23</span></div>
        <div class="pk-row2"><span class="pk-entry">$96.23</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div>
        <div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div>
        <div class="pk-progbar" style="width:0%"></div>
      </div>

      <div class="pk pos">
        <div class="pk-row1"><span class="pk-sym svb-tk-name">ERIC</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$13.24</span></div>
        <div class="pk-row2"><span class="pk-entry">$13.24</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div>
        <div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div>
        <div class="pk-progbar" style="width:0%"></div>
      </div>

      <div class="pk pos">
        <div class="pk-row1"><span class="pk-sym svb-tk-name">MUFG</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$19.38</span></div>
        <div class="pk-row2"><span class="pk-entry">$19.38</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div>
        <div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div>
        <div class="pk-progbar" style="width:0%"></div>
      </div>

      <div class="pk pos">
        <div class="pk-row1"><span class="pk-sym svb-tk-name">ASML</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$1592.00</span></div>
        <div class="pk-row2"><span class="pk-entry">$1,592.00</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div>
        <div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div>
        <div class="pk-progbar" style="width:0%"></div>
      </div>

      <!-- DUP for infinite scroll -->
      <div class="pk pos"><div class="pk-row1"><span class="pk-sym svb-tk-name">ASTS</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$96.23</span></div><div class="pk-row2"><span class="pk-entry">$96.23</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div><div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div><div class="pk-progbar" style="width:0%"></div></div>
      <div class="pk pos"><div class="pk-row1"><span class="pk-sym svb-tk-name">ERIC</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$13.24</span></div><div class="pk-row2"><span class="pk-entry">$13.24</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div><div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div><div class="pk-progbar" style="width:0%"></div></div>
      <div class="pk pos"><div class="pk-row1"><span class="pk-sym svb-tk-name">MUFG</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$19.38</span></div><div class="pk-row2"><span class="pk-entry">$19.38</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div><div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div><div class="pk-progbar" style="width:0%"></div></div>
      <div class="pk pos"><div class="pk-row1"><span class="pk-sym svb-tk-name">ASML</span><span class="pk-mod mod-v13">V13</span><span class="pk-pnl pos svb-tk-price">$1592.00</span></div><div class="pk-row2"><span class="pk-entry">$1,592.00</span><span class="pk-arrow">→</span><span class="pk-curr pos svb-tk-price">—</span><span class="pk-delta pos">+0.00%</span></div><div class="b1-row3"><span class="b1-icon">⏱</span><span class="b1-dates">21/05 → 04/06</span><span class="b1-rest" style="color:rgba(24,232,200,0.85)">NEW</span></div><div class="pk-progbar" style="width:0%"></div></div>"""

# Find and replace the ticker tape content between <div class="tw"><div class="tt"> and </div></div>\n  </div>\n</div>\n\n<!-- ════════ V2E2'
ticker_start_marker = '<div class="tw"><div class="tt">'
ticker_end_marker = '    </div></div>\n  </div>\n</div>\n\n<!-- ════════ V2E2'
# Use regex to replace everything between the markers
pattern = re.compile(
    r'(<div class="tw"><div class="tt">).*?(    </div></div>\n  </div>\n</div>\n\n<!-- ════════ V2E2)',
    re.DOTALL
)
def ticker_replacer(m):
    return m.group(1) + NEW_TICKER_CONTENT + '\n    </div></div>\n  </div>\n</div>\n\n<!-- ════════ V2E2'

new_html, count = re.subn(pattern, ticker_replacer, html, count=1)
if count:
    html = new_html
    changes.append("✅ Ticker tape: replaced 12 hardcoded picks with 4 real picks (ASTS/ERIC/MUFG/ASML)")
else:
    changes.append("⚠️  Ticker tape: pattern not found (already patched?)")

# Fix ticker-lbl-n: 56 → 4
OLD_TICKER_LBL = '<div class="ticker-lbl-n">56</div>'
NEW_TICKER_LBL = '<div class="ticker-lbl-n">4</div>'
if OLD_TICKER_LBL in html:
    html = html.replace(OLD_TICKER_LBL, NEW_TICKER_LBL, 1)
    changes.append("✅ Ticker label: 56 → 4 ABIERTOS")
else:
    changes.append("⚠️  Ticker label: not found (already patched?)")

# ── Fix #1: insert live prices JS before </body> ─────────────────────────────
LIVE_PRICES_JS = """<script id="live-prices-v1">
/* ─── Precios Live via Supabase ─────────────────────────────────────────────
   Corre en el browser al cargar la página.
   Obtiene el cierre más reciente de la tabla `prices` (RLS SELECT abierto
   para anon) y actualiza todas las celdas de precio en el panel de señales
   y en las hero cards. No modifica innerHTML (sin riesgo XSS).
   ────────────────────────────────────────────────────────────────────────── */
(function () {
  'use strict';
  var SB_URL = 'https://okbqqhitseeknruoycby.supabase.co';
  var SB_KEY = 'sb_publishable_6LmzPDDX4D246tPwtuvnhQ_ErX3bE70';

  /* Recolecta tickers únicos del panel de señales (.svb-tk-name) */
  function collectTickers() {
    var s = new Set();
    document.querySelectorAll('.svb-tk-name').forEach(function (el) {
      var t = el.textContent.trim();
      if (/^[A-Z]{1,6}$/.test(t)) s.add(t);
    });
    return Array.from(s);
  }

  /* Fetch a Supabase: último close por ticker */
  function fetchPrices(tickers) {
    var list = tickers.join(',');
    var url = SB_URL + '/rest/v1/prices?select=ticker,date,close,fetched_at'
            + '&ticker=in.(' + list + ')'
            + '&order=date.desc&limit=300';
    return fetch(url, {
      headers: { 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY }
    }).then(function (r) {
      if (!r.ok) throw new Error('Supabase HTTP ' + r.status);
      return r.json();
    }).then(function (rows) {
      var map = {};
      rows.forEach(function (row) {
        if (!map[row.ticker]) map[row.ticker] = row;  // primera fila = más reciente
      });
      return map;
    });
  }

  /* Actualiza precios en la tabla de señales (.svb-tickers-table) */
  function updateSvbTable(map) {
    document.querySelectorAll('.svb-tickers-table tr').forEach(function (tr) {
      var nm = tr.querySelector('.svb-tk-name');
      var pr = tr.querySelector('.svb-tk-price');
      if (nm && pr) {
        var t = nm.textContent.trim();
        if (map[t]) {
          pr.textContent = '$' + parseFloat(map[t].close).toFixed(2);
          pr.title = 'live · cierre ' + map[t].date;
          pr.style.color = '#44e890';
          pr.style.fontWeight = '700';
        }
      }
    });
  }

  /* Actualiza precios en las hero cards (.hc-picks-live)
     Estructura: TICKER_TEXNODE <small.hc-tk-price> <small.hc-tk-pct> <small.hc-tk-date> · TICKER ...
     Los text nodes contienen "TICKER" o " · TICKER" — extraemos el ticker con regex. */
  function updateHeroCards(map) {
    document.querySelectorAll('.hc-picks-live').forEach(function (container) {
      var curTk = null;
      container.childNodes.forEach(function (n) {
        if (n.nodeType === 3) {
          // Extraer último token que sea ticker válido (ignorar " · ")
          var parts = n.textContent.split('\u00b7')   // ·
            .map(function (s) { return s.trim(); })
            .filter(function (s) { return /^[A-Z]{1,6}$/.test(s); });
          if (parts.length) curTk = parts[parts.length - 1];
        } else if (n.nodeType === 1
                   && n.classList.contains('hc-tk-price')
                   && curTk && map[curTk]) {
          n.textContent = ' $' + parseFloat(map[curTk].close).toFixed(2);
          n.title = 'live · cierre ' + map[curTk].date;
          n.style.color = '#44e890';
          n.style.fontWeight = '700';
        }
      });
    });
  }

  /* Agrega badge "precios live · FECHA · HH:MM AR / HH:MM UTC" con hora real del sync */
  function addLiveBadge(maxDate, fetchedAt) {
    if (!maxDate) return;
    var sub = document.getElementById('kpi-fresh-sub');
    if (!sub || document.getElementById('kpi-live-badge')) return;
    var d = document.createElement('div');
    d.id = 'kpi-live-badge';
    d.style.cssText = 'color:#44e890;font-size:10px;margin-top:4px;'
                    + 'font-weight:700;letter-spacing:.05em';
    var label = '\u26a1 precios live \u00b7 ' + maxDate;
    if (fetchedAt) {
      try {
        var ts = new Date(fetchedAt);
        var pad = function(n) { return ('0' + n).slice(-2); };
        var utcH = pad(ts.getUTCHours());
        var utcM = pad(ts.getUTCMinutes());
        var arD  = new Date(ts.getTime() - 3 * 3600000);
        var arH  = pad(arD.getUTCHours());
        var arM  = pad(arD.getUTCMinutes());
        label += ' \u00b7 ' + arH + ':' + arM + ' AR / ' + utcH + ':' + utcM + ' UTC';
      } catch(e) { /* si falla el parse, queda solo la fecha */ }
    }
    d.textContent = label;
    sub.parentNode.insertBefore(d, sub.nextSibling);
  }

  /* Entry point */
  function run() {
    var tickers = collectTickers();
    if (!tickers.length) return;
    fetchPrices(tickers).then(function (map) {
      updateSvbTable(map);
      updateHeroCards(map);
      var entries = Object.values(map).filter(function(r) { return r.date; });
      entries.sort(function(a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
      var latest = entries.length ? entries[entries.length - 1] : null;
      addLiveBadge(
        latest ? latest.date : null,
        latest ? latest.fetched_at : null
      );
    }).catch(function (e) {
      console.warn('[live-prices]', e);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();
</script>"""

if 'id="live-prices-v1"' not in html:
    html = html.replace('</body>', LIVE_PRICES_JS + '\n</body>', 1)
    changes.append("✅ Fix #1: live-prices-v1 JS added before </body>")
else:
    changes.append("ℹ️  Fix #1: live-prices-v1 already present — skipped")

# ── Write result ─────────────────────────────────────────────────────────────
STAGING.write_text(html, encoding="utf-8")

print("=== Staging patch complete ===")
for c in changes:
    print(c)
print(f"\nFile size: {len(html):,} bytes")

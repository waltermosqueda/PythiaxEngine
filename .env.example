APP_ENV=development
TIMEZONE=America/Buenos_Aires
ACTIVE_SCANNER_VERSION=13
ENABLE_LEGACY_ML=false

# Database
# Supabase session pooler / Postgres cloud (required by default)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:change_me@aws-0-<region>.pooler.supabase.com:6543/postgres

# Legacy local-only SQLite mode (explicit opt-in)
# PYTHIAX_ENABLE_SQLITE_FALLBACK=1
# SQLITE_FALLBACK_PATH=titan_system/data/titan.db

# Cloudflare Pages
CF_PAGES_PROJECT=pythiax-engine-dashboard
PUBLIC_DASHBOARD_BASE_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare R2
R2_BUCKET=pythiax-engine-artifacts
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# CI metadata
GITHUB_REPOSITORY=
GITHUB_SHA=

APP_ENV=development
TIMEZONE=America/Buenos_Aires
ACTIVE_SCANNER_VERSION=13
ENABLE_LEGACY_ML=false

# Database
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/claude_titan
SQLITE_FALLBACK_PATH=titan_system/data/titan.db

# Cloudflare Pages
CF_PAGES_PROJECT=claude-titan-dashboard
PUBLIC_DASHBOARD_BASE_URL=

# Cloudflare R2
R2_BUCKET=claude-titan-artifacts
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# CI metadata
GITHUB_REPOSITORY=
GITHUB_SHA=

